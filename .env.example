# Neon Serverless PostgreSQL Connection String (Free at https://neon.tech)
# Example:
DATABASE_URL=postgresql://neondb_owner:npg_your_password@ep-your-project-id.us-east-2.aws.neon.tech/neondb?sslmode=require

# Alternatively, if deploying to Vercel and using Vercel Postgres:
# POSTGRES_URL=postgres://default:...
